# Rendered by `python -m capstone.pipeline.autopilot.ops.schedule`.
# One autopilot tick a day at [schedule] time (local); install with `crontab -e` or
# `crontab <rendered file>` (it replaces the user's crontab). Exit 2 is logged, not retried:
# the next scheduled tick retries every blocked stage, and a STOP waits for `clear`.
${MINUTE} ${HOUR} * * * cd ${CHECKOUT} && PYTHONPATH=${CHECKOUT} PYTHONUTF8=1 ${PYTHON} -m capstone.pipeline.autopilot tick --config ${CONFIG} >> ${LOG} 2>&1 # ${TASK_NAME}
